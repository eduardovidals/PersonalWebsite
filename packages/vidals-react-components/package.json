{
  "name": "@vidals/react-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:stories",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --ci --no-open --disable-telemetry",
    "storybook:build": "storybook build -o storybook-static --disable-telemetry"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "react-aria-components": "1.22.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@vidals/tailwind-theme": "*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.5",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      },
      "test:stories": {
        "dependsOn": [
          "build"
        ]
      },
      "storybook": {
        "dependsOn": [
          "build"
        ]
      },
      "storybook:build": {
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      }
    }
  }
}
