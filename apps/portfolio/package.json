{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "start": "npm run dev",
    "build": "next build --webpack",
    "preview": "sirv out --host 127.0.0.1 --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@emailjs/browser": "5.0.3",
    "@hookform/resolvers": "7.0.5",
    "@vidals/react-components": "*",
    "@vidals/tailwind-theme": "*",
    "gray-matter": "4.0.3",
    "i18next": "27.1.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "sirv-cli": "3.0.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/out",
          "{projectRoot}/.next"
        ],
        "cache": false
      },
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
