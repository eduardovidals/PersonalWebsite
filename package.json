{
  "name": "vidals-portfolio-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prettier": "@vidals/prettier-config",
  "scripts": {
    "start": "npm run dev",
    "dev": "nx run portfolio:dev",
    "build": "nx run portfolio:build",
    "preview": "npm run preview -w portfolio",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "storybook": "nx run @vidals/react-components:storybook",
    "storybook:build": "nx run @vidals/react-components:storybook:build",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "nx": "24.0.4",
    "vitest": "5.1.0",
    "@vidals/eslint-config": "*",
    "@vidals/prettier-config": "*"
  }
}
